# Copia este archivo como .env y completa los valores. Nunca subas .env al repositorio.

# Clave de la API de Anthropic (Claude Console) para el asistente con IA
ANTHROPIC_API_KEY=

# Dominio público del sitio (URL canónica, Open Graph, sitemap y robots)
SITE_URL=https://subestalab.vercel.app

# Tope de preguntas al asistente por día
CHAT_DAILY_LIMIT=400
