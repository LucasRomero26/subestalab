---
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';

interface Props { config: string }
const { config } = Astro.props;

/* Glosario y preguntas frecuentes de la base de conocimiento, para el modo sin conexión. */
type Entry = { q: string; a: string };
let kb: Entry[] = [];
try {
  const md = readFileSync(resolve(process.cwd(), '../conocimiento/SubestaLab_Base_Conocimiento.md'), 'utf-8');
  const section = (title: string) => {
    const i = md.indexOf(title);
    if (i < 0) return '';
    const j = md.indexOf('\n## ', i + title.length);
    return md.slice(i, j < 0 ? undefined : j);
  };
  const clean = (s: string) => s.replace(/\*\*/g, '').replace(/\*/g, '').replace(/`/g, '').trim();
  for (const line of section('## 11. Glosario').split('\n')) {
    const m = line.match(/^- \*\*(.+?):\*\*\s*(.+)$/);
    if (m) kb.push({ q: clean(m[1]), a: `${clean(m[1])}: ${clean(m[2])}` });
  }
  const faq = section('## 12. Preguntas frecuentes').split(/\n\*\*/).slice(1);
  for (const block of faq) {
    const end = block.indexOf('**');
    if (end < 0) continue;
    kb.push({ q: clean(block.slice(0, end)), a: clean(block.slice(end + 2)) });
  }
} catch { kb = []; }
---
<aside class="chat" id="chat" aria-label="Asistente de SubestaLab" data-config={config}>
  <div class="chat-head">
    <div class="chat-id">
      <strong>Asistente SubestaLab</strong>
      <span id="chat-status"><i class="st-dot" aria-hidden="true"></i><span>Listo para ayudarte</span></span>
    </div>
    <button class="btn btn-ghost btn-sm chat-close" id="chat-close" type="button" aria-label="Cerrar asistente">✕</button>
  </div>

  <div class="chat-msgs" id="chat-msgs" aria-label="Conversación anterior">
    <p class="chat-empty" id="chat-empty">Aquí quedará el historial de tus preguntas.</p>
  </div>

  <div class="chat-scene">
    <div class="speech" id="chat-bubble" aria-live="polite">
      <div class="speech-text" id="chat-bubble-text">¡Hola! Estoy aquí para ayudarte con <strong>{config}</strong>. Pregúntame por qué se hace cada maniobra, qué hace un equipo o qué pasaría si cambias el orden.</div>
    </div>
    <div class="scene-row">
      <div class="chat-sugs" id="chat-sugs"></div>
      <div class="chat-avatar" id="chat-avatar" data-pose="1" aria-hidden="true">
        <img class="pose p1" src="/personaje/pose-1.webp" alt="" width="532" height="720" />
        <img class="pose p2" src="/personaje/pose-2.webp" alt="" width="688" height="720" loading="lazy" />
        <img class="pose p3" src="/personaje/pose-3.webp" alt="" width="534" height="720" loading="lazy" />
      </div>
    </div>
  </div>

  <form class="chat-form" id="chat-form">
    <textarea id="chat-input" rows="1" placeholder="Escribe tu pregunta…" aria-label="Tu pregunta" maxlength="600"></textarea>
    <button class="chat-send" type="submit" aria-label="Enviar">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </button>
  </form>
  <p class="chat-note" id="chat-note">Solo responde sobre subestaciones y maniobras.</p>
  <script type="application/json" id="kb-data" set:html={JSON.stringify(kb)} />
</aside>

<script is:inline>
  // Endpoint del asistente con IA. Si no responde (sitio estático o sin API key), el chat usa el modo sin conexión.
  window.SUBESTALAB_CHAT_ENDPOINT = window.SUBESTALAB_CHAT_ENDPOINT || '/api/chat';
</script>

<script>
  import { startChat } from '../client/chat';
  startChat(document.getElementById('chat')!);
</script>
