---
/* Botón flotante del asistente, dentro del tablero (abajo a la derecha). */
---
<button class="assist-fab is-intro" id="btn-chat" type="button" aria-expanded="false" aria-controls="chat" aria-label="Abrir el asistente">
  <span class="fab-label" aria-hidden="true"><span>¿Dudas?</span><b>Pregúntame</b></span>
  <span class="fab-avatar" aria-hidden="true">
    <span class="fab-ring"></span>
    <img src="/personaje/pose-1.webp" alt="" width="532" height="720" />
  </span>
  <span class="fab-dot" aria-hidden="true"></span>
</button>

<script>
  // La etiqueta se muestra unos segundos al cargar y luego se recoge (vuelve al pasar el mouse).
  const fab = document.getElementById('btn-chat');
  setTimeout(() => fab?.classList.remove('is-intro'), 4500);
</script>

<style>
  .assist-fab{
    position:absolute;right:18px;bottom:18px;z-index:7;
    display:flex;align-items:center;gap:0;padding:0;border:0;background:transparent;cursor:pointer;
    transition:opacity .3s,transform .35s var(--ease);
  }
  /* Etiqueta que se despliega hacia la izquierda */
  .fab-label{
    display:flex;flex-direction:column;align-items:flex-end;justify-content:center;
    height:48px;margin-right:-26px;padding:0 38px 0 0;max-width:0;overflow:hidden;
    background:#fff;border:1px solid var(--border);border-right:0;border-radius:99px 0 0 99px;
    box-shadow:0 10px 24px -12px rgba(14,14,14,.35);white-space:nowrap;opacity:0;
    transition:max-width .45s var(--ease),padding .45s var(--ease),opacity .3s;
  }
  .fab-label span{font-size:11px;color:var(--muted);line-height:1.1}
  .fab-label b{font-size:14px;font-weight:700;color:var(--ink);line-height:1.2}
  .assist-fab:hover .fab-label,.assist-fab:focus-visible .fab-label,.assist-fab.is-intro .fab-label{max-width:200px;padding:0 40px 0 18px;opacity:1}

  /* Avatar circular con el personaje */
  .fab-avatar{
    position:relative;width:64px;height:64px;border-radius:50%;flex-shrink:0;overflow:hidden;
    background:radial-gradient(circle at 50% 30%,#C9F7C3 0%,var(--primary) 58%,#4FCB43 100%);
    border:3px solid #fff;box-shadow:0 12px 28px -10px rgba(14,14,14,.45),0 0 0 1px rgba(14,14,14,.08);
    transition:transform .35s var(--ease),box-shadow .35s;
  }
  .fab-avatar img{position:absolute;left:50%;top:6px;width:84%;height:auto;transform:translateX(-50%);transition:transform .45s var(--ease)}
  .assist-fab:hover .fab-avatar{transform:translateY(-2px) scale(1.04);box-shadow:0 18px 34px -12px rgba(14,14,14,.5),0 0 0 1px rgba(14,14,14,.08)}
  .assist-fab:hover .fab-avatar img{transform:translateX(-50%) translateY(-3px) rotate(-3deg)}
  .fab-ring{position:absolute;inset:-3px;border-radius:50%;border:2px solid var(--primary);opacity:0;animation:fab-ring 3.2s ease-out 1.2s infinite}
  @keyframes fab-ring{0%{opacity:.8;transform:scale(1)}70%,100%{opacity:0;transform:scale(1.35)}}

  /* Indicador "en línea" */
  .fab-dot{position:absolute;right:2px;bottom:4px;width:14px;height:14px;border-radius:50%;background:var(--live);border:2.5px solid #fff}

  :global(body.chat-open) .assist-fab{opacity:0;pointer-events:none;transform:scale(.85)}

  @media (max-width:640px){
    .assist-fab{top:10px;right:10px;bottom:auto}
    .fab-avatar{width:48px;height:48px;border-width:2px}
    .fab-label{display:none}
    .fab-dot{width:11px;height:11px;bottom:2px}
  }
  @media (prefers-reduced-motion:reduce){.fab-ring{animation:none}}
</style>
