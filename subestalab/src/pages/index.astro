        for (const x of [140, 240]) {
          g.n(x, 22);
          const y = g.vchain(x, 26, [D.b, D.b, D.b], 17);
          g.w([[x, y], [x, 178]]).n(x, 182);
          for (const yn of [79.5, 124.5]) g.n(x, yn).s('line', x, yn, 90, { len: 46 });
        }
      } },
    9: { label: 'Doble interruptor: barras B1 y B2; cada bahía tiene dos interruptores 52 con sus seccionadores, uno hacia cada barra, y la línea sale entre ambos.',
      build(g) {
        g.bus(46, 286, 22, 'B1').bus(46, 286, 182, 'B2');
        for (const x of [118, 188, 258]) {
          g.n(x, 22).w([[x, 26], [x, 31]]).s('disc', x, 45).w([[x, 59], [x, 65]]).s('brk', x, 79)
           .w([[x, 93], [x, 111]]).s('brk', x, 125).w([[x, 139], [x, 145]]).s('disc', x, 159).w([[x, 173], [x, 178]]).n(x, 182);
          g.n(x, 102).s('line', x, 102, 90, { len: 40 });
        }
      } },
    // Anillo cruzado (Manual de operación UTP, fig. 9): dos anillos de interruptores cuyos nodos enfrentados
    // se unen con interruptores verticales; cada circuito queda conectado por tres interruptores.
    10: { label: 'Anillo cruzado: dos anillos de tres nodos con un interruptor 52 entre cada par de nodos y retorno exterior; los nodos enfrentados se unen con interruptores verticales. Seis circuitos, nueve interruptores.',
      build(g) {
        const xs = [90, 160, 230], yU = 70, yL = 130;
        for (const [y, yr, dir] of [[yU, 42, -1], [yL, 158, 1]]) {
          for (let i = 0; i < 2; i++) {
            const xm = (xs[i] + xs[i + 1]) / 2;
            g.w([[xs[i], y], [xm - 14, y]]).s('brk', xm, y, 90).w([[xm + 14, y], [xs[i + 1], y]]);
          }
          g.w([[xs[2], y], [254, y]]).s('brk', 268, y, 90).w([[282, y], [292, y], [292, yr], [56, yr], [56, y], [xs[0], y]]);
          for (const x of xs) {
            g.halo([x, yr - 5], [x, yr + 5], 'over').w([[x, y], [x, yr + dir * 26]], 'over').n(x, y);
            g.s('line', x, yr + dir * 18, dir < 0 ? 180 : 0, { len: 12 });
          }
        }
        for (const x of xs) g.w([[x, yU], [x, yL]]).s('brk', x, (yU + yL) / 2);
      } }
  };

  document.querySelectorAll('.cfg-card').forEach(card => {
    const cfg = CONFIGS[card.dataset.cfg];
    const g = new Diagram();
    cfg.build(g);
    card.querySelector('.cfg-thumb').innerHTML = g.svg('0 0 300 200', cfg.label);
  });

  /* ======================================================================
     4. SIMULATOR — maintenance of breaker 52, single bus (8 steps)
     ====================================================================== */
  const X = 230;
  // seg(): conductor + hatch band (shown when grounded) + flow dots (shown when energized)
  const seg = (pts, flow = true) => {
    const d = pathD(pts);
    return `<path class="hatch-band" d="${d}"/><path class="w draw" d="${d}"/>${flow ? `<path class="flow" d="${d}"/>` : ''}`;
  };
  const el = (id, delay, inner) => `<g class="el energizado" data-el="${id}" style="--d:${delay}ms">${inner}</g>`;
  const symAt = (name, x, y, opts, rot = 0) => place(SYM[name](opts), x, y, rot, 'draw');
  const lockAt = (x, y) => place(SYM.lock(), x, y, 0, 'loto');
  const sparkLines = [0, 60, 120, 180, 240, 300]
    .map(a => { const r = a * Math.PI / 180; return `M${r2(Math.cos(r) * 22)} ${r2(Math.sin(r) * 22)}L${r2(Math.cos(r) * 30)} ${r2(Math.sin(r) * 30)}`; }).join('');

  const simSVG =
    `<svg class="sld" viewBox="0 0 460 540" role="img" aria-labelledby="sim-svg-title">` +
    `<title id="sim-svg-title">Diagrama unifilar de la bahía de la Línea 1 en barra sencilla</title>` +
    // Bus side — always energized
    el('bus', 0,
      SYM.bus({ x1: 40, x2: 420, y: 48 }) + seg([[X, 52], [X, 90]], false) + place(SYM.node(), X, 48) + chip(54, 14, 'B1 · 230 kV')) +
    el('891', 0, symAt('disc', X, 104) + lockAt(X - 40, 104) + chip(256, 93, '89-1')) +
    // Zone between 89-1 and 52 (de-energizes from 89-1 downwards at step 5)
    el('z1a', 0, seg([[X, 118], [X, 170]])) +
    el('tc', 90, symAt('ct', X, 180) + chip(256, 169, 'TC')) +
    el('z1b', 180, seg([[X, 190], [X, 232]])) +
    el('52', 270, symAt('brk', X, 246) + lockAt(X - 40, 246) + chip(260, 235, '52') +
      `<g transform="translate(${X} 246)"><path class="k spark" d="${sparkLines}" stroke-width="2"/></g>`) +
    // Zone between 52 and 89-2 (de-energizes from 52 downwards at step 3)
    el('z2', 120, seg([[X, 260], [X, 318]])) +
    el('892', 230, symAt('disc', X, 332) + lockAt(X - 40, 332) + chip(256, 321, '89-2')) +
    // Line side: node, earthing switch 57 and line exit
    el('z3a', 320, seg([[X, 346], [X, 392]]) + place(SYM.node(), X, 392, 0, 'draw')) +
    el('z3b', 380, seg([[X, 392], [300, 392], [300, 412]], false)) +
    el('57', 430, symAt('earth', 300, 426, { open: true }) + chip(322, 415, '57')) +
    el('z3c', 400, seg([[X, 392], [X, 470]]) + place(SYM.line({ len: 12 }), X, 470, 0, 'draw') + place(chip(0, 0, 'Línea 1'), X - 37, 492, 0, 'draw')) +
    `<g class="fade-tag" id="sim-test">${chip(104, 300, '0 kV · sin tensión')}</g>` +
    `</svg>`;
  document.getElementById('sim-canvas').innerHTML = simSVG;

  // E = energizado, D = desenergizado, T = a-tierra, M = mantenimiento
  const STATE_CLASS = { E: 'energizado', D: 'desenergizado', T: 'a-tierra', M: 'mantenimiento' };
  const STEPS = [
    { item: 'Verificar condiciones de la bahía',
      title: 'Verificación de condiciones de la bahía: estado de equipos, enclavamientos y permisos de trabajo.',
      cont: 'Línea 1 en servicio', risk: 'Bajo: inspección previa',
      z1: 'E', z2: 'E', z3: 'E', open52: false, open892: false, open891: false, close57: false },
    { item: 'Coordinar la salida de la Línea 1 con el centro de control',
      title: 'Coordinación con el centro de control: se programa la salida de la Línea 1. En barra sencilla no hay transferencia de carga.',
      cont: 'Línea 1 en servicio · salida programada', risk: 'Bajo: coordinación operativa',
      z1: 'E', z2: 'E', z3: 'E', open52: false, open892: false, open891: false, close57: false },
    { item: 'Abrir interruptor 52',
      title: 'Apertura del interruptor 52: la Línea 1 queda sin carga.',
      cont: 'Línea 1 fuera de servicio', risk: 'Medio: seccionadores cerrados',
      z1: 'E', z2: 'D', z3: 'D', open52: true, open892: false, open891: false, close57: false },
    { item: 'Abrir seccionador 89-2 (lado línea)',
      title: 'Apertura del seccionador 89-2 (lado línea): primer corte visible.',
      cont: 'Línea 1 fuera de servicio', risk: 'Medio: 89-1 aún cerrado',
      z1: 'E', z2: 'D', z3: 'D', open52: true, open892: true, open891: false, close57: false },
    { item: 'Abrir seccionador 89-1 (lado barra)',
      title: 'Apertura del seccionador 89-1 (lado barra): corte visible a ambos lados del interruptor 52.',
      cont: 'Línea 1 fuera de servicio', risk: 'Medio: bahía aislada sin tierra',
      z1: 'D', z2: 'D', z3: 'D', open52: true, open892: true, open891: true, close57: false },
    { item: 'Bloquear y señalizar (LOTO)',
      title: 'Bloqueo y señalización (LOTO): 89-1 y 89-2 quedan bloqueados abiertos para que nadie los cierre durante el trabajo.',
      cont: 'Línea 1 fuera de servicio', risk: 'Medio: pendiente verificar y poner a tierra',
      z1: 'D', z2: 'D', z3: 'D', open52: true, open892: true, open891: true, close57: false, loto: true },
    { item: 'Verificar ausencia de tensión',
      title: 'Verificación de ausencia de tensión en la bahía aislada.',
      cont: 'Línea 1 fuera de servicio', risk: 'Medio: pendiente puesta a tierra',
      z1: 'D', z2: 'D', z3: 'D', open52: true, open892: true, open891: true, close57: false, loto: true, test: true },
    { item: 'Cerrar puesta a tierra 57',
      title: 'Cierre de la puesta a tierra 57: la zona queda a tierra y el interruptor 52 listo para su mantenimiento.',
      cont: 'Línea 1 fuera de servicio', risk: 'Bajo: zona puesta a tierra y bloqueada',
      z1: 'M', z2: 'M', z3: 'T', open52: true, open892: true, open891: true, close57: true, loto: true }
  ];

  const $ = id => document.getElementById(id);
  const sim = $('sim-canvas');
  const E = id => sim.querySelector(`[data-el="${id}"]`);
  const setState = (id, code) => {
    const node = E(id);
    Object.values(STATE_CLASS).forEach(c => node.classList.remove(c));
    node.classList.add(STATE_CLASS[code]);
  };
  const setOpen = (id, open) => E(id).querySelector('.sym.brk, .sym.disc').classList.toggle('is-open', open);

  const CHECK = '<svg viewBox="0 0 10 10" aria-hidden="true"><path d="M1.8 5.2L4 7.3L8.2 2.8" fill="none" stroke="#0E0E0E" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>';
  const list = $('sim-list');
  list.innerHTML = STEPS.map((s, i) => `<li><span class="seq-ico"></span><span>${String(i + 1).padStart(2, '0')} ${s.item}</span></li>`).join('');

  let step = 0;
  function render(prev) {
    const s = STEPS[step];
    // Zones
    ['z1a', 'tc', 'z1b'].forEach(id => setState(id, s.z1));
    setState('52', s.z1 === 'M' ? 'M' : (s.z1 === 'E' ? 'E' : 'D'));
    setState('z2', s.z2);
    setState('892', s.z2 === 'E' ? 'E' : 'D');
    ['z3a', 'z3b', 'z3c', '57'].forEach(id => setState(id, s.z3));
    setState('891', 'E');
    setState('bus', 'E');
    // Switching devices
    setOpen('52', s.open52);
    setOpen('892', s.open892);
    setOpen('891', s.open891);
    E('57').querySelector('.sym.disc').classList.toggle('is-open', !s.close57);
    E('891').classList.toggle('bloq', !!s.loto);
    E('892').classList.toggle('bloq', !!s.loto);
    $('sim-test').classList.toggle('on', !!s.test);
    // Spark only when the breaker actually opens (step 2 → 3)
    if (prev === 1 && step === 2) {
      const sp = E('52').querySelector('.spark');
      sp.classList.remove('go'); void sp.getBoundingClientRect(); sp.classList.add('go');
    }
    // Panel
    const pct = ((step + 1) / STEPS.length * 100);
    $('sim-badge').textContent = `Paso ${step + 1} de ${STEPS.length}`;
    $('sim-pct').textContent = `${+pct.toFixed(1)}%`;
    $('sim-bar').style.width = pct + '%';
    $('sim-progress').setAttribute('aria-valuenow', step + 1);
    $('sim-title').textContent = s.title;
    $('sim-cont').textContent = s.cont;
    $('sim-risk').textContent = s.risk;
    [...list.children].forEach((li, i) => {
      li.className = i < step ? 'is-done' : i === step ? 'is-current' : 'is-todo';
      li.toggleAttribute('aria-current', i === step);
      li.firstElementChild.innerHTML = i < step ? CHECK : String(i + 1);
    });
    $('sim-prev').disabled = step === 0;
    $('sim-next').disabled = step === STEPS.length - 1;
  }
  $('sim-prev').addEventListener('click', () => { if (step > 0) { const p = step--; render(p); } onSimInput(); });
  $('sim-next').addEventListener('click', () => { if (step < STEPS.length - 1) { const p = step++; render(p); } onSimInput(); });
  render(-1);

  // Nudge towards "Siguiente": pulse + hint when the simulator first comes into view,
  // pulse again after 7 s without interaction (never on the last step).
  const nextBtn = $('sim-next'), hint = $('sim-hint');
  let simTouched = false, simVisible = false, idleTimer = 0;
  const setNudge = on => nextBtn.classList.toggle('nudge', on && step < STEPS.length - 1);
  const armIdle = () => {
    clearTimeout(idleTimer);
    if (step < STEPS.length - 1) idleTimer = setTimeout(() => { if (simVisible) setNudge(true); }, 7000);
  };
  function onSimInput() {
    simTouched = true;
    hint.classList.remove('on');
    setNudge(false);
    armIdle();
  }
  new IntersectionObserver(([en]) => {
    simVisible = en.isIntersecting;
    if (simVisible && !simTouched) setTimeout(() => { if (!simTouched && simVisible) { setNudge(true); hint.classList.add('on'); } }, 500);
  }, { threshold: 0.35 }).observe(document.querySelector('.sim'));

  /* ======================================================================
     5. LEGEND — same classes and symbols as the diagrams
     ====================================================================== */
  const legendItem = (cls, inner, text) =>
    `<div class="legend-item"><svg class="sld" viewBox="0 0 44 22" role="img" aria-label="${text}"><g class="${cls}">${inner}</g></svg><span>${text}</span></div>`;
  $('legend').innerHTML =
    legendItem('energizado', `<path class="w draw" d="M4 11H40"/>`, 'Energizado') +
    legendItem('desenergizado', `<path class="w draw" d="M4 11H40"/>`, 'Desenergizado') +
    legendItem('a-tierra', `<path class="hatch-band" d="M4 9H28" style="stroke-width:10"/><path class="w draw" d="M4 9H28"/>` +
      place(SYM.gnd(), 34, 9, 0, '').replace('<g ', '<g ') .replace('translate(34 9)', 'translate(34 9) scale(.6)'), 'Puesto a tierra') +
    legendItem('mantenimiento', `<path class="w draw" d="M3 11H24"/>` + place(SYM.lock(), 34, 10, 0, 'loto').replace('translate(34 10)', 'translate(34 10) scale(.85)'), 'En mant. (LOTO)');

  /* ======================================================================
     6. MODO INTERACTIVO — palette + canvas
     ====================================================================== */
  const PALETTE = [
    ['Barraje', 'Barraje', '-20 -20 40 40', SYM.bus({ x1: -17, x2: 17 })],
    ['52', 'Interruptor 52', '-20 -20 40 40', `<path class="k" d="M0 -20V-14M0 14V20"/>` + SYM.brk()],
    ['89', 'Seccionador 89', '-20 -20 40 40', `<path class="k" d="M0 -20V-14M0 14V20"/>` + SYM.disc({ open: true })],
    ['57', 'Seccionador de puesta a tierra 57', '-24 -20 48 52', `<path class="k" d="M0 -20V-14"/>` + SYM.earth({ open: true })],
    ['TC', 'Transformador de corriente', '-20 -20 40 40', `<path class="k" d="M0 -18V18"/>` + SYM.ct()],
    ['TP', 'Transformador de potencial', '-20 -22 40 40', SYM.vt()],
    ['DPS', 'Descargador de sobretensiones', '-22 -22 44 50', SYM.dps()],
    ['TO', 'Trampa de onda', '-20 -20 40 40', `<path class="k" d="M0 -20V-16M0 16V20"/>` + SYM.to()],
    ['Trafo', 'Transformador de potencia', '-22 -24 44 48', `<path class="k" d="M0 -24V-18M0 18V24"/>` + SYM.trafo()],
    ['Línea', 'Salida de línea', '-20 -20 40 40', place(SYM.line({ len: 34 }), 0, -17)]
  ];
  $('palette').innerHTML = PALETTE.map(([lbl, name, vb, inner]) =>
    `<li title="${name}"><svg class="sld" viewBox="${vb}" role="img" aria-label="${name}">${inner}</svg><span>${lbl}</span></li>`).join('');

  (() => {
    const g = new Diagram(), x = 230;
    g.bus(40, 360, 34).n(x, 34);
    let y = g.vchain(x, 38, [D.d], 22);           // 89-1  (60–88)
    y = g.vchain(x, y, [['ct']], 20);              // TC    (108–128)
    y = g.vchain(x, y, [D.b], 18);                 // 52    (146–174)
    y = g.vchain(x, y, [D.d], 20);                 // 89-2  (194–222)
    g.w([[x, y], [x, 244]]).n(x, 244);
    g.w([[x, 244], [286, 244], [286, 254]]).s('earth', 286, 268, 0, { open: true }); // 57
    g.s('line', x, 244, 0, { len: 58 });           // Línea
    g.add(chip(48, 7, 'B1 · 230 kV') + chip(250, 63, '89-1') + chip(250, 107, 'TC') + chip(250, 149, '52') +
      chip(250, 197, '89-2') + chip(306, 257, '57') + chip(146, 280, 'Línea 1'));
    // TP being dragged towards the line-side node
    g.add(
      `<circle class="snap-ring" cx="${x}" cy="232" r="9"/>` +
      `<path class="k drag-link" d="M134 166C180 166 196 232 ${x - 12} 232" stroke-width="1.5"/>` +
      `<g transform="translate(110 166)"><g class="drag">` +
        `<rect x="-24" y="-24" width="48" height="48" rx="8" fill="#fff" stroke="#0E0E0E" stroke-width="1.5" stroke-dasharray="4 3"/>` +
        place(SYM.vt(), 0, 4) +
        chip(-35, -50, 'Arrastrando: TP', true) +
        `<path d="M14 14L14 33L19 28L23 36L26.5 34.5L22.5 26.5L29 26.5Z" fill="#fff" stroke="#0E0E0E" stroke-width="1.5" stroke-linejoin="round"/>` +
      `</g></g>`);
    $('lab-canvas').innerHTML = g.svg('0 0 400 320',
      'Lienzo del modo interactivo: bahía completa con barra B1, seccionador 89-1, TC, interruptor 52, seccionador 89-2, seccionador de puesta a tierra 57 y salida de línea; un TP se está arrastrando hacia el nodo del lado de línea.');
  })();

  // Pause the hero energy pulses while the hero is off screen
  new IntersectionObserver(([en]) => document.querySelector('.hero').classList.toggle('is-offscreen', !en.isIntersecting))
    .observe(document.querySelector('.hero'));

  /* ======================================================================
     7. FAVICON (same monogram), NAVIGATION
     ====================================================================== */
  const logo = document.getElementById('sl-logo');
  $('favicon').href = 'data:image/svg+xml,' + encodeURIComponent(
    `<svg xmlns="http://www.w3.org/2000/svg" viewBox="132 153 1000 1000">${logo.innerHTML}</svg>`);

  const toggle = document.querySelector('.menu-toggle');
  const menu = $('mobile-menu');
  const setMenu = open => {
    menu.hidden = !open;
    toggle.setAttribute('aria-expanded', open);
    toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    toggle.querySelector('path').setAttribute('d', open ? 'M6 6l12 12M18 6L6 18' : 'M4 7h16M4 12h16M4 17h16');
  };
  toggle.addEventListener('click', () => setMenu(menu.hidden));
  menu.addEventListener('click', e => { if (e.target.closest('a')) setMenu(false); });
  document.addEventListener('keydown', e => { if (e.key === 'Escape' && !menu.hidden) { setMenu(false); toggle.focus(); } });
  matchMedia('(min-width: 900px)').addEventListener('change', e => { if (e.matches) setMenu(false); });

  // Active link = section crossing the upper part of the viewport
  const sections = ['configuraciones', 'como-funciona', 'modo-interactivo', 'acerca-de'].map($);
  const links = [...document.querySelectorAll('.nav-links a, .mobile-menu a:not(.btn)')];
  const setActive = id => links.forEach(a => {
    const on = a.getAttribute('href') === '#' + id;
    a.classList.toggle('is-active', on);
    if (on) a.setAttribute('aria-current', 'true'); else a.removeAttribute('aria-current');
  });
  const updateActive = () => {
    const probe = innerHeight * 0.35;
    let current = null;
    for (const s of sections) if (s.getBoundingClientRect().top <= probe) current = s.id;
    if (innerHeight + scrollY >= document.documentElement.scrollHeight - 2) current = sections[sections.length - 1].id;
    setActive(current);
  };
  addEventListener('scroll', updateActive, { passive: true });
  addEventListener('resize', updateActive);
  updateActive();
})();
</script>
</body>
</html>
