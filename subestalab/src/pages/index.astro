          g.w([[x, 132], [x, 140]]).s('disc', x, 154, 0, { open: true }).w([[x, 168], [x, 180]]).n(x, 184);
        });
        const j = selectors(g, 248, 20, 38, 62, 1);
        const y = g.vchain(248, j, [D.bo, D.d]);
        g.w([[248, y], [248, 180]]).n(248, 184);
      } },
    7: { label: 'Anillo: anillo cerrado de cuatro interruptores 52, cada uno entre dos seccionadores 89; las cuatro líneas salen de los nodos entre interruptores.',
      build(g) {
        const L = 86, R = 214, T = 30, B = 172;
        g.hchain(L, T, [D.d, D.b, D.d], 11); g.w([[203, T], [R, T]]);
        g.hchain(L, B, [D.d, D.b, D.d], 11); g.w([[203, B], [R, B]]);
        g.vchain(L, T, [D.d, D.b, D.d], 14.5); g.w([[L, 157.5], [L, B]]);
        g.vchain(R, T, [D.d, D.b, D.d], 14.5); g.w([[R, 157.5], [R, B]]);
        for (const [x, y, rot] of [[L, T, 90], [L, B, 90], [R, T, -90], [R, B, -90]]) g.n(x, y).s('line', x, y, rot, { len: 44 });
      } },
    8: { label: 'Interruptor y medio: barras B1 y B2; cada diámetro tiene tres interruptores 52 en serie entre las dos barras, con dos líneas derivadas entre ellos.',
      build(g) {
