---
import '../styles/landing.css';
import Seo from '../components/Seo.astro';
import { FAVICON } from '../lib/brand';
import { homeSchema } from '../lib/schema';
---
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<Seo title="SubestaLab — Maniobras en subestaciones eléctricas, paso a paso"
  description="SubestaLab: aprende paso a paso las maniobras de mantenimiento de interruptores y barras en 10 configuraciones de barraje de subestaciones eléctricas, con simulación animada, modo práctica y asistente con IA."
  image="/og/home.png" imageAlt="SubestaLab: maniobra una subestación, paso a paso"
  jsonLd={homeSchema(Astro.site!)} />
<link rel="icon" type="image/svg+xml" id="favicon" href={FAVICON}>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>


<!-- Shared SVG defs: logo (also used as favicon) and the hatch pattern for grounded zones -->
<svg class="sprite" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <pattern id="hatch" width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <line x1="0" y1="0" x2="0" y2="5" stroke="#0E0E0E" stroke-width="1.4"/>
    </pattern>
  </defs>
  <!-- Monogram "SL" (provided artwork, redrawn as vector): S = single-line conductor with a breaker
       on the central curve, terminal node and an energized (lime) node; L = lattice tower on its base. -->
  <symbol id="sl-logo" viewBox="140 318 985 654">
    <path d="M585 402H365A132 128 0 0 0 365 658H540A117 131 0 0 1 540 920H190" fill="none" stroke="#0E0E0E" stroke-width="46" stroke-linecap="round" stroke-linejoin="round"/>
    <rect x="396" y="604" width="107" height="110" fill="#0E0E0E"/>
    <circle cx="190" cy="920" r="44" fill="#0E0E0E"/>
    <circle cx="624" cy="405" r="36" fill="#7BEA6F" stroke="#0E0E0E" stroke-width="20"/>
    <path d="M742 352V840" fill="none" stroke="#0E0E0E" stroke-width="50" stroke-linecap="round"/>
    <path d="M717 830Q713 892 686 914L700 926H766V830Z" fill="#0E0E0E"/>
    <path d="M840 445L878 432L908 904H854Z" fill="#0E0E0E"/>
    <path d="M762 372L868 432M766 404L840 444L766 512L845 610L766 682L850 780L766 860" fill="none" stroke="#0E0E0E" stroke-width="22" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M702 925H1094" fill="none" stroke="#0E0E0E" stroke-width="46" stroke-linecap="round"/>
  </symbol>
</svg>

<header class="site-header">
  <div class="container nav-bar">
    <a class="brand" href="#inicio" aria-label="SubestaLab, ir al inicio">
      <svg viewBox="0 0 60 40" role="img" aria-label="Logotipo SubestaLab"><use href="#sl-logo" width="60" height="40"/></svg>
    </a>
    <nav class="nav-links" aria-label="Principal">
      <a href="#configuraciones">Configuraciones</a>
      <a href="#como-funciona">Cómo funciona</a>
      <a href="#modo-interactivo">Modo interactivo</a>
      <a href="#acerca-de">Acerca de</a>
    </nav>
    <div class="nav-actions">
      <a class="btn btn-dark" href="/configuraciones">Comenzar</a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Abrir menú">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path class="k" d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>
  <div class="mobile-menu" id="mobile-menu" hidden>
    <nav class="container" aria-label="Principal (móvil)">
      <ul>
        <li><a href="#configuraciones">Configuraciones</a></li>
        <li><a href="#como-funciona">Cómo funciona</a></li>
        <li><a href="#modo-interactivo">Modo interactivo</a></li>
        <li><a href="#acerca-de">Acerca de</a></li>
        <li><a class="btn btn-dark" href="/configuraciones">Comenzar</a></li>
      </ul>
    </nav>
  </div>
</header>

<main id="inicio">

  <!-- HERO -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero-inner">
      <div class="hero-copy">
        <h1 id="hero-title">Maniobra una subestación, paso a paso.</h1>
        <p class="hero-sub">Aprende las maniobras de mantenimiento en 10 configuraciones de barraje.</p>
        <div class="hero-ctas">
          <a class="btn btn-primary" href="/configuraciones">Comenzar</a>
          <a class="btn btn-outline" href="#configuraciones">Ver configuraciones</a>
        </div>
        <div class="stats">
          <div class="stat"><div class="stat-num">10</div><div class="stat-label">Configuraciones</div></div>
          <div class="stat"><div class="stat-num">13</div><div class="stat-label">Elementos</div></div>
          <div class="stat"><div class="stat-num">3</div><div class="stat-label">Modos <span>· Guiado, práctica e interactivo</span></div></div>
        </div>
      </div>
      <div class="hero-art">
        <!-- Alternative illustration: assets/hero-subestacion-alt.webp (1456×1080) -->
        <img src="/assets/hero-subestacion.webp" width="1536" height="1024" alt="Ilustración a lápiz de una subestación eléctrica de alta tensión" fetchpriority="high" decoding="async">
        <!-- Conductor paths traced from the drawing (image pixel coordinates) -->
        <svg class="energy" viewBox="0 0 1536 1024" preserveAspectRatio="xMaxYMax meet" aria-hidden="true" focusable="false"><g style="--t:3.6s;--dl:0.0s"><path class="glow" pathLength="1000" d="M1350 20L1081 150L430 415"/><path class="core" pathLength="1000" d="M1350 20L1081 150L430 415"/></g><g style="--t:3.0s;--dl:0.9s"><path class="glow" pathLength="1000" d="M1468 44L1148 198L816 344"/><path class="core" pathLength="1000" d="M1468 44L1148 198L816 344"/></g><g style="--t:2.6s;--dl:1.7s"><path class="glow" pathLength="1000" d="M1500 131L1060 310"/><path class="core" pathLength="1000" d="M1500 131L1060 310"/></g><g style="--t:2.8s;--dl:0.4s"><path class="glow" pathLength="1000" d="M1520 234L1282 328L1055 429"/><path class="core" pathLength="1000" d="M1520 234L1282 328L1055 429"/></g><g style="--t:3.1s;--dl:1.3s"><path class="glow" pathLength="1000" d="M975 280L372 492"/><path class="core" pathLength="1000" d="M975 280L372 492"/></g><g style="--t:3.3s;--dl:2.2s"><path class="glow" pathLength="1000" d="M931 312L371 508"/><path class="core" pathLength="1000" d="M931 312L371 508"/></g><g style="--t:2.2s;--dl:2.6s"><path class="glow" pathLength="1000" d="M1264 361L994 455"/><path class="core" pathLength="1000" d="M1264 361L994 455"/></g><g style="--t:2.4s;--dl:0.6s"><path class="glow" pathLength="1000" d="M1021 376L741 465"/><path class="core" pathLength="1000" d="M1021 376L741 465"/></g><g style="--t:2.7s;--dl:1.9s"><path class="glow" pathLength="1000" d="M942 418L547 530"/><path class="core" pathLength="1000" d="M942 418L547 530"/></g></svg>
      </div>
    </div>
  </section>

  <!-- CONFIGURACIONES -->
  <section class="section" id="configuraciones" aria-labelledby="cfg-title">
    <div class="container">
      <div class="section-head">
        <h2 class="h2" id="cfg-title">Configuraciones</h2>
      </div>
      <div class="cfg-grid">
        <a class="cfg-card" href="/configuraciones/barra-sencilla" data-cfg="1"><div class="cfg-thumb"></div><div class="cfg-foot"><span class="cfg-name">Barra sencilla</span><span class="tag">Básica</span></div></a>
        <a class="cfg-card" href="/configuraciones/barra-principal-transferencia" data-cfg="2"><div class="cfg-thumb"></div><div class="cfg-foot"><span class="cfg-name">Barra ppal. + transferencia</span><span class="tag">Intermedia</span></div></a>
        <a class="cfg-card" href="/configuraciones/doble-barra" data-cfg="3"><div class="cfg-thumb"></div><div class="cfg-foot"><span class="cfg-name">Doble barra</span><span class="tag">Intermedia</span></div></a>
        <a class="cfg-card" href="/configuraciones/doble-barra-bypass" data-cfg="4"><div class="cfg-thumb"></div><div class="cfg-foot"><span class="cfg-name">Doble barra + <span class="nw">by-pass</span></span><span class="tag">Intermedia</span></div></a>
        <a class="cfg-card" href="/configuraciones/doble-barra-seccionador-transferencia" data-cfg="5"><div class="cfg-thumb"></div><div class="cfg-foot"><span class="cfg-name">DB + secc. de transferencia</span><span class="tag">Avanzada</span></div></a>
        <a class="cfg-card" href="/configuraciones/doble-barra-barra-transferencia" data-cfg="6"><div class="cfg-thumb"></div><div class="cfg-foot"><span class="cfg-name">DB + barra de transferencia</span><span class="tag">Avanzada</span></div></a>
        <a class="cfg-card" href="/configuraciones/anillo" data-cfg="7"><div class="cfg-thumb"></div><div class="cfg-foot"><span class="cfg-name">Anillo</span><span class="tag">Intermedia</span></div></a>
        <a class="cfg-card" href="/configuraciones/interruptor-y-medio" data-cfg="8"><div class="cfg-thumb"></div><div class="cfg-foot"><span class="cfg-name">Interruptor y medio</span><span class="tag">Avanzada</span></div></a>
        <a class="cfg-card" href="/configuraciones/doble-interruptor" data-cfg="9"><div class="cfg-thumb"></div><div class="cfg-foot"><span class="cfg-name">Doble interruptor</span><span class="tag">Avanzada</span></div></a>
        <a class="cfg-card" href="/configuraciones/anillo-cruzado" data-cfg="10"><div class="cfg-thumb"></div><div class="cfg-foot"><span class="cfg-name">Anillo cruzado</span><span class="tag">Avanzada</span></div></a>
      </div>
    </div>
  </section>

  <!-- CÓMO FUNCIONA -->
  <section class="section" id="como-funciona" aria-labelledby="how-title">
    <div class="container">
      <div class="section-head">
        <h2 class="h2" id="how-title">Cómo funciona</h2>
        <p class="lead-sm">Aprende la secuencia operativa sin riesgos</p>
      </div>

      <ol class="stepper" aria-label="Cómo se usa SubestaLab">
        <li class="step"><span class="step-dot">01</span><span class="step-label">Elige una configuración</span></li>
        <li class="step is-current" aria-current="step"><span class="step-dot">02</span><span class="step-label">Avanza paso a paso</span></li>
        <li class="step"><span class="step-dot">03</span><span class="step-label">Observa el sistema</span></li>
      </ol>

      <div class="sim">
        <div class="sim-stage">
          <div class="sim-canvas" id="sim-canvas"></div>
          <div class="sim-legend">
            <div class="eyebrow">Convención de estados</div>
            <div class="legend" id="legend"></div>
          </div>
        </div>
        <div class="sim-side">
          <div class="sim-head">
            <div class="sim-meta">
              <div class="sim-meta-l">
                <span class="eyebrow">Secuencia</span>
                <span class="badge" id="sim-badge">Paso 1 de 8</span>
              </div>
              <span class="pct" id="sim-pct">12.5%</span>
            </div>
            <div class="progress" id="sim-progress" role="progressbar" aria-label="Progreso de la maniobra" aria-valuemin="0" aria-valuemax="8" aria-valuenow="1">
              <div class="progress-bar" id="sim-bar"></div>
            </div>
            <h3 class="sim-title" id="sim-title" aria-live="polite"></h3>
          </div>

          <div class="seq">
            <div class="eyebrow">Secuencia de maniobra</div>
            <ol id="sim-list"></ol>
          </div>

          <div class="kpis">
            <div class="kpi"><div class="eyebrow">Continuidad</div><div class="kpi-val" id="sim-cont"></div></div>
            <div class="kpi"><div class="eyebrow">Riesgo operativo</div><div class="kpi-val" id="sim-risk"></div></div>
          </div>

          <div class="sim-nav">
            <button class="btn btn-outline" type="button" id="sim-prev">Anterior</button>
            <div class="next-wrap">
              <span class="sim-hint" id="sim-hint" aria-hidden="true"><i></i>Pulsa «Siguiente» para avanzar</span>
              <button class="btn btn-dark" type="button" id="sim-next">Siguiente<svg class="btn-arrow" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- MODO INTERACTIVO -->
  <section class="section" id="modo-interactivo" aria-labelledby="lab-title">
    <div class="container">
      <div class="lab">
        <div class="lab-copy">
          <span class="eyebrow">Entorno experimental</span>
          <h2 class="h2" id="lab-title">Diseña tu propia subestación</h2>
          <p>Arrastra, conecta y valida tu propia configuración.</p>
          <a class="btn btn-primary" href="/laboratorio">Probar modo interactivo</a>
        </div>
        <div class="lab-work">
          <ul class="palette" id="palette" aria-label="Paleta de elementos"></ul>
          <div class="lab-canvas" id="lab-canvas"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ACERCA DE -->
  <section class="section" id="acerca-de" aria-labelledby="about-title">
    <div class="container">
      <div class="about">
        <div>
          <h2 id="about-title">Acerca de</h2>
          <p class="about-text">SubestaLab es una herramienta educativa interactiva para estudiar las configuraciones de barraje y los procesos de maniobra durante el mantenimiento de interruptores y barras en subestaciones eléctricas. Cada secuencia se presenta paso a paso, mostrando qué partes del sistema quedan energizadas, cuáles se aíslan y qué riesgos implica cada operación.</p>
        </div>
        <dl class="facts">
          <div><dt>Propósito</dt><dd>Apoyar visualmente el aprendizaje de maniobras en subestaciones de alta tensión.</dd></div>
          <div><dt>Institución</dt><dd>Universidad del Norte · Subestaciones Eléctricas, Tema 2</dd></div>
          <div><dt>Equipo</dt><dd>Prof. Jose David Doria García (docente) · Lucas Romero Mercado (desarrollo)</dd></div>
        </dl>
      </div>
    </div>
  </section>
</main>

<footer class="site-footer">
  <div class="container footer-inner">
    <a class="brand" href="#inicio" aria-label="SubestaLab, volver al inicio">
      <svg viewBox="0 0 60 40" role="img" aria-label="Logotipo SubestaLab"><use href="#sl-logo" width="60" height="40"/></svg>
    </a>
    <nav class="footer-links" aria-label="Pie de página">
      <a href="#configuraciones">Configuraciones</a>
      <a href="#como-funciona">Cómo funciona</a>
      <a href="#modo-interactivo">Modo interactivo</a>
      <a href="#acerca-de">Acerca de</a>
    </nav>
    <div class="footer-meta">
      <div>© 2026 SubestaLab. Fines educativos.</div>
      <div>Universidad del Norte · Subestaciones Eléctricas</div>
      <div>Desarrollado por Lucas Romero Mercado</div>
    </div>
  </div>
</footer>

<script is:inline>
(() => {
  'use strict';

  /* ======================================================================
     1. SYMBOL LIBRARY — every element is defined exactly once, here.
        Local coordinates, vertical orientation, terminals on the y axis.
     ====================================================================== */
  const groundPath = y => `M-9 ${y}H9M-5.5 ${y + 5}H5.5M-2 ${y + 10}H2`;

  const SYM = {
    // Barraje: 8 px pill. Transfer bus (BT) = same pill, hollow with a 2 px outline.
    bus: ({ x1, x2, y = 0, label = '', t = false }) =>
      `<g class="sym bus">` +
        (t ? `<rect class="bus-bar--t" x="${x1 + 1}" y="${y - 3}" width="${x2 - x1 - 2}" height="6" rx="3"/>`
           : `<rect class="bus-bar" x="${x1}" y="${y - 4}" width="${x2 - x1}" height="8" rx="4"/>`) +
        (label ? `<text class="bus-lbl" x="${x1 - 7}" y="${y + 4.5}" text-anchor="end">${label}</text>` : '') +
      `</g>`,

    // Interruptor 52: 28 px square, 6 px corners. Closed = filled; open = hollow with separated contacts.
    brk: ({ open = false } = {}) =>
      `<g class="sym brk${open ? ' is-open' : ''}"><rect class="brk-body" x="-14" y="-14" width="28" height="28" rx="6"/>` +
      `<path class="k" d="M0 -14V-4.5M0 14V4.5"/></g>`,

    // Seccionador 89: IEC knife — fixed contact on top, blade on a circular pivot. Open = rotated 30°.
    disc: ({ open = false } = {}) =>
      `<g class="sym disc${open ? ' is-open' : ''}"><path class="k" d="M-6.5 -14H6.5"/>` +
      `<g transform="translate(0 14)"><g class="blade"><path class="k" d="M0 0V-28"/></g></g>` +
      `<circle class="piv" cy="14" r="3"/></g>`,

    // Tierra (IEC 60617)
    gnd: () => `<g class="sym gnd"><path class="k" d="M0 -6V0${groundPath(0)}"/></g>`,

    // Seccionador de puesta a tierra 57: knife (pivot on the earth side) + earth.
    earth: ({ open = true } = {}) =>
      `<g class="sym earth">${SYM.disc({ open })}<path class="k" d="M0 17V21${groundPath(21)}"/></g>`,

    // Transformador de corriente (TC): conductor through a ring.
    ct: () => `<g class="sym ct"><path class="k" d="M0 -10V10"/><circle class="k nf" r="10"/></g>`,

    // Transformador de potencial (TP): two coupled windings, branch connection on top.
    vt: () => `<g class="sym vt"><path class="k" d="M0 -20V-12"/><circle class="k wf" cy="-4.5" r="7.5"/><circle class="k nf" cy="5.5" r="7.5"/></g>`,

    // Transformador de potencia
    trafo: () => `<g class="sym trafo"><circle class="k wf" cy="-7" r="11"/><circle class="k nf" cy="7" r="11"/></g>`,

    // Descargador de sobretensiones (DPS): resistor body with internal arrow, to earth.
    dps: () =>
      `<g class="sym dps"><path class="k" d="M0 -20V-11"/><rect class="k wf" x="-6.5" y="-11" width="13" height="22" rx="1.5"/>` +
      `<path class="k" d="M0 -6V2"/><path class="fk" d="M0 7L-3.6 1.5H3.6Z"/><path class="k" d="M0 11V16${groundPath(16)}"/></g>`,

    // Trampa de onda (TO): series line trap coil.
    to: () => `<g class="sym to"><path class="k" d="M0 -16V-10a2.5 2.5 0 0 1 0 5a2.5 2.5 0 0 1 0 5a2.5 2.5 0 0 1 0 5a2.5 2.5 0 0 1 0 5V16"/></g>`,

    // Salida de línea: conductor ending in an arrow.
    line: ({ len = 30 } = {}) => `<g class="sym line"><path class="k" d="M0 0V${len}M-5.5 ${len - 7}L0 ${len}L5.5 ${len - 7}"/></g>`,

    // Candado LOTO: own outline padlock, 2.5 px black line.
    lock: () => `<g class="sym lock"><path class="k" d="M-4.5 -2V-6.5a4.5 4.5 0 0 1 9 0V-2"/><rect class="k wf" x="-7.5" y="-2" width="15" height="12" rx="2.5"/><path class="k" d="M0 2.5V5.5"/></g>`,

    node: () => `<circle class="node" r="3.6"/>`
  };
  const HALF = { disc: 14, brk: 14, ct: 10, to: 16, trafo: 18 };

  const place = (markup, x, y, rot = 0, cls = '') =>
    `<g${cls ? ` class="${cls}"` : ''} transform="translate(${r2(x)} ${r2(y)})${rot ? ` rotate(${r2(rot)})` : ''}">${markup}</g>`;
  const r2 = n => Math.round(n * 100) / 100;
  const pathD = pts => 'M' + pts.map(p => `${r2(p[0])} ${r2(p[1])}`).join('L');

  function chip(x, y, text, dark = false) {
    const w = Math.round(18 + text.length * 6.6);
    return `<g class="chip${dark ? ' chip--dark' : ''}" transform="translate(${x} ${y})"><rect width="${w}" height="22" rx="11"/><text x="${w / 2}" y="15">${text}</text></g>`;
  }

  /* ======================================================================
     2. DIAGRAM BUILDER (layers keep buses under wires under symbols)
     ====================================================================== */
  class Diagram {
    constructor() { this.L = { bus: [], halo: [], wire: [], over: [], sym: [], node: [], top: [] }; }
    bus(x1, x2, y, label, t = false) { this.L.bus.push(SYM.bus({ x1, x2, y, label, t })); return this; }
    // White gap where a conductor passes over a bus without connecting to it.
    halo(p1, p2, layer = 'halo') { this.L[layer].push(`<path class="halo" d="${pathD([p1, p2])}"/>`); return this; }
    w(pts, layer = 'wire') { this.L[layer].push(`<path class="w" d="${pathD(pts)}"/>`); return this; }
    s(name, x, y, rot = 0, opts) { this.L.sym.push(place(SYM[name](opts), x, y, rot)); return this; }
    n(x, y) { this.L.node.push(place(SYM.node(), x, y)); return this; }
    add(markup, layer = 'top') { this.L[layer].push(markup); return this; }
    // Vertical chain: wire + element + wire ... starting at (x, y). Returns the last y.
    vchain(x, y, items, gap = 8) {
      for (const [name, opts] of items) {
        const h = HALF[name], top = y + gap;
        this.w([[x, y], [x, top]]).s(name, x, top + h, 0, opts);
        y = top + 2 * h;
      }
      return y;
    }
    // Horizontal chain (elements rotated 90°), left to right.
    hchain(x, y, items, gap = 8) {
      for (const [name, opts] of items) {
        const h = HALF[name], l = x + gap;
        this.w([[x, y], [l, y]]).s(name, l + h, y, 90, opts);
        x = l + 2 * h;
      }
      return x;
    }
    svg(viewBox, label, cls = 'sld') {
      const L = this.L;
      return `<svg class="${cls}" viewBox="${viewBox}" role="img" aria-label="${label}"><g class="energizado">` +
        L.bus.join('') + L.halo.join('') + L.wire.join('') + L.over.join('') + L.sym.join('') + L.node.join('') + L.top.join('') +
        `</g></svg>`;
    }
  }

  /* ======================================================================
     3. CONFIGURATION THUMBNAILS (validated against Tema_2_Configuraciones.pdf)
        viewBox 0 0 300 200. Normally-open devices are drawn open.
     ====================================================================== */
  const D = { b: ['brk'], bo: ['brk', { open: true }], d: ['disc'], do: ['disc', { open: true }] };

  // Double-bus feeder head: selector from B1 (left, passes over B2) and from B2 (right).
  function selectors(g, x, yB1, yB2, cy, onBus) {
    g.n(x - 12, yB1).w([[x - 12, yB1 + 4], [x - 12, cy - 14]]).halo([x - 12, yB2 - 5], [x - 12, yB2 + 5])
     .s('disc', x - 12, cy, 0, { open: onBus !== 1 });
    g.n(x + 12, yB2).w([[x + 12, yB2 + 4], [x + 12, cy - 14]]).s('disc', x + 12, cy, 0, { open: onBus !== 2 });
    const j = cy + 22;
    g.w([[x - 12, cy + 14], [x - 12, j], [x + 12, j], [x + 12, cy + 14]]).n(x, j);
    return j;
  }
  // Bus coupler between B1 and B2: 89 – 52 – 89 drawn as a U.
  function coupler(g, xl, xr, yB1, yB2, cy, yb) {
    g.n(xl, yB1).w([[xl, yB1 + 4], [xl, cy - 14]]).halo([xl, yB2 - 5], [xl, yB2 + 5]).s('disc', xl, cy);
    g.n(xr, yB2).w([[xr, yB2 + 4], [xr, cy - 14]]).s('disc', xr, cy);
    const xm = (xl + xr) / 2;
    g.w([[xl, cy + 14], [xl, yb], [xm - 14, yb]]).s('brk', xm, yb, 90).w([[xm + 14, yb], [xr, yb], [xr, cy + 14]]);
  }

  const CONFIGS = {
    1: { label: 'Barra sencilla: una barra B1 y tres bahías; cada bahía con seccionador 89, interruptor 52, seccionador 89 y salida de línea.',
