---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import HeadAssets from '../components/HeadAssets.astro';
import { LOGO_PATHS } from '../lib/brand';

interface Props {
  title: string;
  description: string;
  bodyClass?: string;
  image?: string;
  imageAlt?: string;
  jsonLd?: object | object[];
  noindex?: boolean;
}
const { bodyClass = '', ...seo } = Astro.props;
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <Seo {...seo} />
  <HeadAssets />
</head>
<body class={bodyClass}>
  <svg class="sr-only" aria-hidden="true" focusable="false"><symbol id="sl-logo" viewBox="140 318 985 654" set:html={LOGO_PATHS} /></svg>
  <slot />
</body>
</html>
